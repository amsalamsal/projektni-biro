<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AutoCAD host adapter. Built twice:
      net8.0-windows  against the AutoCAD 2025 API (AutoCAD.NET 25.0.x) -> loads in AutoCAD 2025 and 2026
      net10.0-windows against the AutoCAD 2027 API (AutoCAD.NET 26.0.x) -> loads in AutoCAD 2027
    AutoCAD assemblies are reference-only (never copied). WPF/WinForms come from the Windows Desktop
    framework reference, so the project also builds on non-Windows build machines (EnableWindowsTargeting).
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>SiteDesignPro.AutoCAD</RootNamespace>
    <AssemblyName>SiteDesignPro.AutoCAD</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="26.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SiteDesignPro.Core\SiteDesignPro.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\*.png" LogicalName="SiteDesignPro.Icons.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
