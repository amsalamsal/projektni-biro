<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AutoCAD host adapter. One source tree, four builds (AutoCAD breaks binary compatibility between these series):
      net47           against the AutoCAD 2020 API (AutoCAD.NET 23.1.0, R23.1) -> AutoCAD 2020
      net48           against the AutoCAD 2021 API (AutoCAD.NET 24.0.0, R24.0) -> AutoCAD 2021, 2022, 2023, 2024
      net8.0-windows  against the AutoCAD 2025 API (AutoCAD.NET 25.0.x)        -> AutoCAD 2025 and 2026
      net10.0-windows against the AutoCAD 2027 API (AutoCAD.NET 26.0.x)        -> AutoCAD 2027
    AutoCAD assemblies are reference-only (never copied). WPF/WinForms come from the Windows Desktop
    framework reference, so the project also builds on non-Windows build machines (EnableWindowsTargeting).
  -->
  <PropertyGroup>
    <TargetFrameworks>net47;net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>SiteDesignPro.AutoCAD</RootNamespace>
    <AssemblyName>SiteDesignPro.AutoCAD</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="!$(TargetFramework.StartsWith('net4'))">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net47'">
    <PackageReference Include="AutoCAD.NET" Version="23.1.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="AutoCAD.NET" Version="24.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="26.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SiteDesignPro.Core\SiteDesignPro.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\*.png" LogicalName="SiteDesignPro.Icons.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
