{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projektni-biro/site-design-pro/terrain.schema.json",
  "title": "Site Design Pro terrain surfaces (terrain.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lengthUnit",
    "surfaces"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "lengthUnit": {
      "const": "m"
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "vertices",
          "triangles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "vertices": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "triangles": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "breaklines": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "statistics": {
            "type": "object"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "severity",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "location": {
                  "type": "array"
                }
              }
            }
          }
        }
      }
    }
  }
}
